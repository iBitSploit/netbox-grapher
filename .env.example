# Browser configuration. VITE_* values are embedded in the client bundle.
VITE_APP_NAME=Infrastructure Map
VITE_REPOSITORY_URL=
VITE_NETBOX_URL=
# Do not use this for production secrets. Tokens are visible to browser users.
VITE_NETBOX_TOKEN=
VITE_NETBOX_API_PREFIX=api
VITE_STORAGE_KEY=netbox-config
VITE_DEFAULT_VIEW=racks
VITE_AUTO_REFRESH=false
VITE_REFRESH_INTERVAL_MS=30000
VITE_ENABLE_IP_GRAPH=true
VITE_ENABLE_CIRCUITS=true

# Docker Compose host port (not read by Vite).
COMPOSE_PORT=8080
